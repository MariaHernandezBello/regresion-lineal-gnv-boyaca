    "\n",
    "outliers = df[\n",
    "    (df[\"CANTIDAD VOLUMEN SUMINISTRADO\"] < limite_inferior) |\n",
    "    (df[\"CANTIDAD VOLUMEN SUMINISTRADO\"] > limite_superior)\n",
    "]\n",
